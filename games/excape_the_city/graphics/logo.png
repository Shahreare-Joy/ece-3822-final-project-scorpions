<svg viewBox="0 0 600 220" xmlns="http://www.w3.org/2000/svg" width="600" height="220">
  <defs>
    <!-- City grid background pattern -->
    <pattern id="grid" width="20" height="20" patternUnits="userSpaceOnUse">
      <path d="M 20 0 L 0 0 0 20" fill="none" stroke="#1a2a3a" stroke-width="0.5"/>
    </pattern>

    <!-- Neon glow filter for main text -->
    <filter id="neonGlow" x="-20%" y="-50%" width="140%" height="200%">
      <feGaussianBlur stdDeviation="3" result="blur1"/>
      <feGaussianBlur stdDeviation="8" result="blur2"/>
      <feMerge>
        <feMergeNode in="blur2"/>
        <feMergeNode in="blur1"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>

    <!-- Subtle glow for subtitle -->
    <filter id="subtleGlow" x="-10%" y="-50%" width="120%" height="200%">
      <feGaussianBlur stdDeviation="2" result="blur"/>
      <feMerge>
        <feMergeNode in="blur"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>

    <!-- Arrow glow -->
    <filter id="arrowGlow" x="-30%" y="-30%" width="160%" height="160%">
      <feGaussianBlur stdDeviation="4" result="blur"/>
      <feMerge>
        <feMergeNode in="blur"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>

    <!-- Gradient for main text -->
    <linearGradient id="textGrad" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#00f0ff"/>
      <stop offset="50%" stop-color="#ffffff"/>
      <stop offset="100%" stop-color="#ff4fd8"/>
    </linearGradient>

    <!-- Gradient for buildings silhouette -->
    <linearGradient id="cityGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#0d1f2d"/>
      <stop offset="100%" stop-color="#050e18"/>
    </linearGradient>

    <!-- Scanline overlay -->
    <pattern id="scanlines" width="1" height="3" patternUnits="userSpaceOnUse">
      <rect width="1" height="1" fill="rgba(0,0,0,0.15)"/>
    </pattern>

    <!-- Clip path for the whole logo -->
    <clipPath id="logoClip">
      <rect x="0" y="0" width="600" height="220" rx="6"/>
    </clipPath>
  </defs>

  <g clip-path="url(#logoClip)">
    <!-- Dark background -->
    <rect width="600" height="220" fill="#050e18"/>

    <!-- Grid overlay -->
    <rect width="600" height="220" fill="url(#grid)"/>

    <!-- City skyline silhouette (bottom) -->
    <!-- Buildings -->
    <g fill="url(#cityGrad)" opacity="0.7">
      <!-- Far left cluster -->
      <rect x="0" y="155" width="18" height="65"/>
      <rect x="5" y="140" width="12" height="80"/>
      <rect x="18" y="162" width="22" height="58"/>
      <rect x="26" y="148" width="10" height="72"/>
      <!-- Left cluster -->
      <rect x="40" y="130" width="25" height="90"/>
      <rect x="48" y="115" width="14" height="105"/>
      <rect x="65" y="143" width="20" height="77"/>
      <rect x="72" y="155" width="8" height="65"/>
      <!-- Mid-left -->
      <rect x="80" y="125" width="18" height="95"/>
      <rect x="90" y="108" width="22" height="112"/>
      <rect x="98" y="120" width="10" height="100"/>
      <!-- Center-left  -->
      <rect x="108" y="140" width="16" height="80"/>
      <rect x="118" y="128" width="20" height="92"/>
      <rect x="130" y="152" width="14" height="68"/>
      <!-- Center gap (the escape path) - intentionally shorter buildings -->
      <rect x="144" y="165" width="12" height="55"/>
      <rect x="152" y="175" width="8" height="45"/>
      <!-- Continue right side -->
      <rect x="430" y="170" width="10" height="50"/>
      <rect x="438" y="160" width="14" height="60"/>
      <rect x="450" y="148" width="20" height="72"/>
      <rect x="462" y="135" width="16" height="85"/>
      <rect x="475" y="125" width="22" height="95"/>
      <rect x="490" y="112" width="14" height="108"/>
      <rect x="498" y="128" width="18" height="92"/>
      <rect x="510" y="142" width="20" height="78"/>
      <rect x="524" y="155" width="12" height="65"/>
      <rect x="532" y="145" width="16" height="75"/>
      <rect x="545" y="130" width="22" height="90"/>
      <rect x="560" y="148" width="18" height="72"/>
      <rect x="572" y="138" width="14" height="82"/>
      <rect x="582" y="155" width="18" height="65"/>
    </g>

    <!-- Window lights in buildings - tiny yellow dots -->
    <g fill="#ffe066" opacity="0.5" font-size="2">
      <!-- Left buildings windows -->
      <rect x="50" y="118" width="2" height="2"/>
      <rect x="55" y="124" width="2" height="2"/>
      <rect x="50" y="130" width="2" height="2"/>
      <rect x="56" y="136" width="2" height="2"/>
      <rect x="92" y="112" width="2" height="2"/>
      <rect x="97" y="118" width="2" height="2"/>
      <rect x="92" y="125" width="2" height="2"/>
      <rect x="97" y="131" width="2" height="2"/>
      <rect x="92" y="138" width="2" height="2"/>
      <rect x="120" y="132" width="2" height="2"/>
      <rect x="126" y="138" width="2" height="2"/>
      <rect x="120" y="145" width="2" height="2"/>
      <!-- Right buildings windows -->
      <rect x="478" y="128" width="2" height="2"/>
      <rect x="484" y="135" width="2" height="2"/>
      <rect x="478" y="142" width="2" height="2"/>
      <rect x="493" y="116" width="2" height="2"/>
      <rect x="498" y="122" width="2" height="2"/>
      <rect x="493" y="130" width="2" height="2"/>
      <rect x="498" y="138" width="2" height="2"/>
      <rect x="548" y="133" width="2" height="2"/>
      <rect x="554" y="140" width="2" height="2"/>
      <rect x="548" y="148" width="2" height="2"/>
    </g>

    <!-- Escape path / road glow in center -->
    <ellipse cx="300" cy="200" rx="140" ry="30" fill="#00f0ff" opacity="0.04"/>
    <rect x="290" y="170" width="20" height="50" fill="#00f0ff" opacity="0.03"/>

    <!-- Horizontal speed lines (motion blur effect) -->
    <g stroke="#00f0ff" opacity="0.12" stroke-width="1">
      <line x1="20" y1="90" x2="180" y2="90"/>
      <line x1="20" y1="97" x2="155" y2="97"/>
      <line x1="20" y1="104" x2="165" y2="104"/>
    </g>
    <g stroke="#ff4fd8" opacity="0.12" stroke-width="1">
      <line x1="420" y1="90" x2="580" y2="90"/>
      <line x1="445" y1="97" x2="580" y2="97"/>
      <line x1="435" y1="104" x2="580" y2="104"/>
    </g>

    <!-- Arrow / chevron pointing right (escape symbol) -->
    <g filter="url(#arrowGlow)" transform="translate(268, 60)">
      <polyline points="0,0 28,22 0,44" fill="none" stroke="#00f0ff" stroke-width="3" stroke-linejoin="round" stroke-linecap="round" opacity="0.9"/>
      <polyline points="18,0 46,22 18,44" fill="none" stroke="#ffffff" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round" opacity="0.5"/>
    </g>

    <!-- Main title: ESCAPE -->
    <text
      x="300"
      y="105"
      text-anchor="middle"
      font-family="'Arial Black', 'Impact', sans-serif"
      font-size="68"
      font-weight="900"
      letter-spacing="12"
      fill="url(#textGrad)"
      filter="url(#neonGlow)"
      transform="translate(-6, 0)"
    >ESCAPE</text>

    <!-- Thin separator line -->
    <line x1="130" y1="118" x2="470" y2="118" stroke="#00f0ff" stroke-width="0.5" opacity="0.4"/>

    <!-- Subtitle: THE CITY -->
    <text
      x="300"
      y="148"
      text-anchor="middle"
      font-family="'Arial', sans-serif"
      font-size="26"
      font-weight="400"
      letter-spacing="20"
      fill="#aaddff"
      filter="url(#subtleGlow)"
      opacity="0.85"
    >THE CITY</text>

    <!-- Scanline overlay for screen effect -->
    <rect width="600" height="220" fill="url(#scanlines)" opacity="0.4"/>

    <!-- Top-left corner bracket -->
    <path d="M 18 10 L 10 10 L 10 28" fill="none" stroke="#00f0ff" stroke-width="1.5" opacity="0.6"/>
    <!-- Top-right corner bracket -->
    <path d="M 582 10 L 590 10 L 590 28" fill="none" stroke="#00f0ff" stroke-width="1.5" opacity="0.6"/>
    <!-- Bottom-left corner bracket -->
    <path d="M 18 210 L 10 210 L 10 192" fill="none" stroke="#ff4fd8" stroke-width="1.5" opacity="0.6"/>
    <!-- Bottom-right corner bracket -->
    <path d="M 582 210 L 590 210 L 590 192" fill="none" stroke="#ff4fd8" stroke-width="1.5" opacity="0.6"/>
  </g>
</svg>
